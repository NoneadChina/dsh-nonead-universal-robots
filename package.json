{
  "name": "dsh-nonead-universal-robots",
  "version": "0.8.2",
  "description": "一个让 DSH 用自然语言直接控制 Universal Robots（UR）机械臂的插件，由拓德科技（Nonead）基于自研的 nUR MCP Server 同源逻辑开发。",
  "type": "module",
  "main": "lib/index.js",
  "readme": "README.md",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.js.map",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "requirements.txt",
    "python/__init__.py",
    "python/ur_worker.py",
    "python/URBasic/**/*.py",
    "python/URBasic/rtdeConfiguration.xml",
    "python/URBasic/rtdeConfigurationDefault.xml"
  ],
  "scripts": {
    "prepublishOnly": "npm run check && npm run check:host:strict && npm test",
    "check": "npm run check:static && npm run check:ops && npm run check:docs && npm run check:manifest && npm run check:host",
    "check:static": "node --check lib/index.js && node --check lib/worker.js && node scripts/check-package-metadata.mjs && node scripts/check-client-bundle.mjs",
    "check:ops": "node scripts/run-py.mjs scripts/check-worker-ops.py && node scripts/run-py.mjs scripts/check-new-ops.py && node scripts/run-py.mjs scripts/check-approval-gate.py && node scripts/run-py.mjs scripts/check-tool-params.py && node scripts/run-py.mjs scripts/check-rtde-recipe.py",
    "check:docs": "node scripts/check-doc-tools.mjs",
    "check:manifest": "node scripts/check-test-manifest.mjs",
    "check:host": "node scripts/check-host-compat.mjs --allow-missing-host",
    "check:host:strict": "node scripts/check-host-compat.mjs --strict",
    "test": "node scripts/run-tests.mjs",
    "test:node": "node scripts/run-tests.mjs --skip-python",
    "test:python": "node scripts/run-py.mjs python/ur_worker.py --selfcheck",
    "python:where": "node scripts/run-py.mjs --which",
    "build:client": "node scripts/build-client.mjs",
    "verify:models": "node scripts/run-py.mjs scripts/verify-models.py",
    "analyze:models": "node scripts/analyze-models.mjs",
    "compress:models": "node scripts/compress-models.mjs --write",
    "compress:models:textures": "node scripts/compress-models.mjs --write --texture-size 1024",
    "verify:host": "node scripts/check-host-compat.mjs --strict"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "universal-robots",
    "ur",
    "robot",
    "collaborative-robot",
    "cobot",
    "urtool",
    "industrial-robot",
    "urscript",
    "rtde",
    "mcp"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "拓德科技 (Suzhou Nonead Robot Technology Co., Ltd.)",
    "url": "https://www.nonead.com"
  },
  "homepage": "https://www.nonead.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoneadChina/dsh-nonead-universal-robots.git"
  },
  "bugs": {
    "url": "https://github.com/NoneadChina/dsh-nonead-universal-robots/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.5-alpha.2 || ^4.0.6-alpha.1",
    "@deepseek-ai/dsh": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-alpha.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2 || ^0.2.1-alpha.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2 || ^3.18.5-alpha.2 || ^3.18.6-alpha.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.15",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "^0.180.0"
  }
}
