# =============================================================================
# dsh-nonead-universal-robots · UR / URSim 演示脚本集
#
# 内容：一段 30 秒舞蹈 + 一段「机械臂写字」作图演示。
# 全部内容已在 URSim 3.15.8.106339（UR10，192.168.8.128）上实跑验证。
#
# 基准位姿（脚本开始前机器人的 TCP，工具朝下）：
#   P_PAPER z = 0.23078910206725664   ← 「纸面」高度，作图平面
#   P_UP    z = 0.29078910206725667   ← 抬笔高度 = 纸面 + 0.06 m
#   朝向      = [-0.0012209830284133727, 3.116276481240895, 0.038891916168133256]
#               （rx≈0, ry≈π ⇒ 工具 Z 轴指向基座 -Z，即笔尖朝下）
#
# 坐标系：以下所有位姿都是**基座系**的绝对位姿 p[x,y,z,rx,ry,rz]，
#         位置单位米、姿态单位弧度，与 ur_movel / ur_draw_* 的入参一致。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、舞蹈：12 拍 × movej(t=2.5) = 30.0 s，收尾精确回到起点
#     t=2.5 表示「这一拍恰好走 2.5 秒」（给了 t 就忽略 a/v）；
#     不带 r（交融半径）⇒ 每拍都停稳，总时长严格 30.0 s。
# -----------------------------------------------------------------------------
def demo_dance_30s():
    movej([-1.0007,-1.6271,-1.9030,0.3920,1.1951,1.4690], t=2.5)
    movej([-2.2007,-1.6271,-1.9030,-2.0080,1.1951,-1.5310], t=2.5)
    movej([-1.0007,-1.4271,-1.7030,0.3920,1.7951,-1.5310], t=2.5)
    movej([-2.2007,-1.4271,-1.7030,-2.0080,1.7951,1.4690], t=2.5)
    movej([-1.6007,-1.1771,-1.5030,-0.8080,0.8951,-0.0310], t=2.5)
    movej([-1.6007,-2.0771,-2.7530,-0.8080,2.1951,-0.0310], t=2.5)
    movej([-0.7507,-1.5271,-2.0030,0.0920,1.2951,1.8690], t=2.5)
    movej([-2.4507,-1.5271,-2.0030,-1.7080,1.2951,-1.9310], t=2.5)
    movej([-1.1507,-1.2771,-1.6030,0.7920,1.0951,0.9690], t=2.5)
    movej([-1.6007,-1.2771,-1.6030,1.3920,1.0951,-0.0310], t=2.5)
    movej([-2.0507,-1.5271,-1.9030,-2.4080,1.7951,-1.0310], t=2.5)
    movej([-1.6007,-1.7271,-2.2030,-0.8080,1.5951,-0.0310], t=2.5)
end


# -----------------------------------------------------------------------------
# 二、作图用「抬笔 / 落笔」平移
#     抬笔 = movel 到目标点上方（z = P_UP）；随后的作图函数首句会垂直落到纸面。
# -----------------------------------------------------------------------------

def demo_pen_up_to_circle_start():
    # 圆的起点 = 圆心 + (-r, 0)，r = 0.09
    movel(p[-0.27, -0.61, 0.29078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], 1.2, 0.25, 0.0, 0.0)
end

def demo_pen_up_to_star_start():
    # 五角星首个顶点 = 星心 + (0, +R)，R = side/(2·sin72°) = 0.05257311121191337
    movel(p[-0.18, -0.3674269, 0.29078910206725667, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], 1.2, 0.25, 0.0, 0.0)
end

def demo_pen_up_home():
    movel(p[-0.1799259141475472, -0.6068697551627643, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], 1.2, 0.25, 0.0, 0.0)
end


# -----------------------------------------------------------------------------
# 三、画圆（水平面，半径 0.09 m）
#     由 ur_draw_circle(coordinate="xy") 生成：movep 落到起点 + 两段各 180° 的
#     movec 拼成一个整圆。r=0.025 是交融半径，让圆更顺。
# -----------------------------------------------------------------------------
def demo_write_circle():
    movep(p[-0.27, -0.61, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25, r=0.025)
    movec(p[-0.18, -0.52, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], p[-0.09, -0.61, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25, r=0.025)
    movec(p[-0.18, -0.70, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], p[-0.27, -0.61, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25, r=0.025)
end


# -----------------------------------------------------------------------------
# 四、画五角星（水平面，边长 0.10 m，外接半径 0.0525731 m）
#     由 ur_draw_star(coordinate="xy") 生成：5 段 movel 按「隔一个顶点连一笔」
#     的顺序 [0,2,4,1,3,0] 连成。r=0.0 保证笔画是折线、顶点不被打圆。
# -----------------------------------------------------------------------------
def demo_write_star():
    movel(p[-0.1800,-0.3674,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
    movel(p[-0.2109,-0.4625,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
    movel(p[-0.1300,-0.4038,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
    movel(p[-0.2300,-0.4038,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
    movel(p[-0.1491,-0.4625,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
    movel(p[-0.1800,-0.3674,0.2308,-0.0012,3.1163,0.0389], a=1, v=0.25, r=0.0)
end


# -----------------------------------------------------------------------------
# 五、画「落款方印」（水平面，边长 0.05 m）
#     ⚠️ 本次实测是在**没有抬笔**的情况下执行的——方框前的定位 movel 被审批门禁
#     拒绝，于是机器人贴着纸面从上一位置斜拖到 origin 再起画，纸面上会多出一条
#     引线。要画得干净，请先执行 demo_pen_up_* 系列。
#     由 ur_draw_square(coordinate="xy") 生成。注意 draw_square 的 coordinate
#     默认是 "z"（竖直面），要在水平面画必须显式传 "xy"。
#     origin 取左下角，路线为 origin → +y → +x → +y → 回 origin。
# -----------------------------------------------------------------------------
def demo_write_square():
    movel(p[-0.10, -0.45, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25)
    movel(p[-0.10, -0.40, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25)
    movel(p[-0.05, -0.40, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25)
    movel(p[-0.05, -0.45, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25)
    movel(p[-0.10, -0.45, 0.23078910206725664, -0.0012209830284133727, 3.116276481240895, 0.038891916168133256], a=1, v=0.25)
end


# -----------------------------------------------------------------------------
# 六、完整「写字」演示：抬笔 → 画圆 → 抬笔 → 画星 → 回原位
#     在水平面上（x 向右、y 向上）画出：
#
#        y
#        ↑
#      -0.37 ┤              ★
#      -0.40 ┤                      ┌────┐
#      -0.42 ┤            ★   ★     │    │  五角星 中心(-0.18,-0.42) 边长 0.10
#      -0.45 ┤                      └────┘  方框   左下角(-0.10,-0.45) 边长 0.05
#      -0.47 ┤              ★
#      -0.52 ┤      ╭───────────╮
#      -0.61 ┤      │     ○     │           圆     中心(-0.18,-0.61) 半径 0.09
#      -0.70 ┤      ╰───────────╯
#            └───┬──────┬──────┬────┬─→ x
#              -0.27  -0.18  -0.10 -0.05
#
#     实测：圆与五角星连续执行到完成，收尾 TCP 与起始位姿偏差 < 0.04 mm；
#     方框为随后单独补画（见第五节说明）。
# -----------------------------------------------------------------------------
def demo_write_picture():
    demo_pen_up_to_circle_start()
    demo_write_circle()
    demo_pen_up_to_star_start()
    demo_write_star()
    demo_pen_up_home()
end


# =============================================================================
# 用法
# =============================================================================
# 1) 若要整段发给控制器：取消下面一行的注释后再发送（URScript 只定义函数是
#    不会执行的，必须在顶层调用）：
#
# demo_write_picture()
#
# 2) 若通过 dsh-nonead-universal-robots 的 ur_send_script 下发：插件会把执行
#    哨兵注入到**函数体内部**，所以脚本里**只能留一个 def、且顶层必须显式调用**
#    它，否则拿不到「是否真的跑完」的证据。
#
# 3) 已知坑：
#    · movel/movej 带 r（交融半径）时**收点不到位**——实测 r=0.03 会让 TCP 停在
#      离目标 2.9 cm 处。要精确复位就用一段不带 r 的移动补回来。
#    · ur_draw_square / ur_draw_rectangle 的 coordinate 默认是 "z"（竖直面），
#      要画平放的方框必须显式传 "xy"。
#    · 运动类 op（movel / draw_* / send_script 等）都在人工审批门禁 APPROVAL_OPS 内：
#      approval policy=ask 且无人应答时会**挂满 60s 超时且脚本从未下发**；policy=never
#      时直接拒绝。判别依据是 URSim 上 $HOME/URSim_Linux-<版本>/URControl.log 里
#      有没有对应的 `Starting program:` 行——没有就是没下发。
# =============================================================================
